<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= locals.title %>
    </title>
</head>
<body>
    <h1>Messages</h1>
    <p><a href="/new">Enter a New Message Here</a></p>
    <% for (const message of locals.messages) { %>
        <h2>Message:
            <%= message.text %>
        </h2>
        <h3>From:
            <%= message.username %>
        </h3>
        <h4>At:
            <%= message.date %>
        </h4>
        <p><a href="/details/<%= message.id %>">View Details</a></p>
    <% } %>
</body>
</html>